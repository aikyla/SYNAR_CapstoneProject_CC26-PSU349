# Server
PORT=3000

# JWT — use a strong random string (min 32 chars)
JWT_SECRET=your_jwt_secret_here

# Firebase — paste the full JSON content of your service account key (single line)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# AI Service — FastAPI URL from AI team (leave empty if not available yet)
AI_SERVICE_URL=http://localhost:8000/predict
