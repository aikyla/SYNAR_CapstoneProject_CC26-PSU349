# Server
PORT=3000

# JWT — use a strong random string (min 32 chars)
JWT_SECRET=your_jwt_secret_here

# Firebase — full JSON content of service account key (single line wrapped in single quotes)
FIREBASE_SERVICE_ACCOUNT=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON

# AI Service — FastAPI URL from AI team (e.g. port 8000 for standard FastAPI reload)
AI_SERVICE_URL=http://localhost:8000/predict
REGRESSION_SERVICE_URL=http://localhost:8001

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SYNAR <example@gmail.com>
FRONTEND_URL=http://localhost:5173
